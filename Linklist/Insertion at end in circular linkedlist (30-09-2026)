#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node *next;
};

int main() {
    struct node *head, *n, *t;

    head = (struct node*)malloc(sizeof(struct node));
    head->data = 10;

    n = (struct node*)malloc(sizeof(struct node));
    n->data = 20;

    head->next = n;
    n->next = head;
    n = (struct node*)malloc(sizeof(struct node));
    n->data = 15;

    t = head;
    while (t->next != head) {
        t = t->next;
    }

    t->next = n;
    n->next = head;
    t = head;
    do {
        printf("%d ", t->data);
        t = t->next;
    } while (t != head);

    return 0;
}
