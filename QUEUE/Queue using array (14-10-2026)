#include <stdio.h>
#define SIZE 5
int q[SIZE];
int f=-1,r=-1;
void insert()
{
    int x;
    if (r==SIZE-1)
        printf("Queue is full\n");
    else
    {
        printf("Enter element: ");
        scanf("%d", &x);
        if (f == -1)
            f = 0;
        r++;
        q[r] = x;
    }
}
void delete()
{
    if (f == -1)
        printf("Queue is empty\n");
    else
    {
        printf("Deleted element = %d\n", q[f]);

        if (f==r)
            f=r=-1;
        else
            f++;
    }
}
void display()
{
    int i;

    if (f == -1)
        printf("Queue is empty\n");
    else
    {
        for (i=f;i<=r;i++)
            printf("%d ",q[i]);
        printf("\n");
    }
}
int main()
{
    int choice;
    do
    {
        printf("\n1. Insert");
        printf("\n2. Delete");
        printf("\n3. Display");
        printf("\n4. Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);
        switch (choice)
        {
            case 1: insert(); break;
            case 2: delete(); break;
            case 3: display(); break;
            case 4: break;
            default: printf("Invalid choice\n");
        }
    } while (choice!=4);
    return 0;
}
